# =============================================================================
# access-matrix 后端 (core-service) — 部署环境变量模板  ·  English: .env.example
# -----------------------------------------------------------------------------
# 复制为 `backend/.env` 并按你的环境填值。
#
# Spring Boot 不会自动加载 .env。本文件只是给真正注入环境变量的工具做参考：
# docker-compose env_file / systemd EnvironmentFile / k8s Secret envFrom /
# 裸 shell `set -a; . ./backend/.env; set +a`。
# （前端有自己的构建期 env：frontend/.env.*，与此无关。）
#
# 分层：  [1] 必填    — 不设应用无法启动。
#         [2] 功能项  — 仅当用到该功能时才需要（邮件 / 首次引导）。
#         [3] 可选    — 其余都在 application*.yml 有默认值；有理由再覆盖（先读那里的注释）。
# 标 "# default: X" 的，是变量未设时 application.yml 的回退值。
# =============================================================================


# ── [1] 必填 — 不设无法启动 ─────────────────────────────────────────────────

# 生效的 Spring profile。不设 → "prod"（oidc 鉴权 + 租户隔离开启）。
# 开发用 "local"。（prod profile = application-prod.yml）
#SPRING_PROFILES_ACTIVE=prod

# Postgres — 应用数据库。保留 ?stringtype=unspecified（应用靠它做 jsonb / enum 绑定）。
CORE_DB_URL=jdbc:postgresql://db-host:5432/access_matrix?stringtype=unspecified
CORE_DB_USERNAME=access_matrix
CORE_DB_PASSWORD=change-me

# Redis — 会话 / 限流 / 强制登出。prod profile 走 TLS 连 Redis
# （spring.data.redis.ssl.enabled=true），所以生产的 Redis 必须支持 TLS。
CORE_REDIS_HOST=redis-host
#CORE_REDIS_PORT=6379          # default: 6379
#CORE_REDIS_PASSWORD=          # default: (无)
#CORE_REDIS_DB=0               # default: 0

# 允许调用 API 的浏览器来源。逗号分隔，精确到 scheme+host（结尾不带 /）——即 SPA 的对外地址。
CORE_CORS_ALLOWED_ORIGINS=https://app.yourco.com

# SSO / Keycloak — 生产默认 OIDC，故以下必填。
# 运行时后端以专用 service-account（client_credentials）调用 Keycloak Admin API
# —— 运行时无 admin 密码，只需它的 secret。
# ⚠ PROVISIONER_SECRET：后端是把这个值“推”进 Keycloak，强度由你负责。绝不能把 dev
#   默认值（dev-provisioner-secret-change-in-prod）带去生产——那等于给一个 create-realm
#   服务账号挂了公开已知的密码。生成：openssl rand -base64 32 → 存进 vault。
CORE_OIDC_ISSUER_BASE_URI=https://auth.yourco.com   # 多 realm 信任前缀（realm == 租户）
CORE_KEYCLOAK_SERVER_URL=https://auth.yourco.com
CORE_KEYCLOAK_PROVISIONER_SECRET=                   # vault 里的强 secret；运行时身份


# ── [2] 邮件 — 用到邀请 / 密码重置 / 开通流程则必填 ──────────────────────────
# 不设也能启动，但这些流程会静默不发邮件，被邀请的用户收不到设密码链接。真实部署应启用。
CORE_MAIL_ENABLED=true
CORE_MAIL_HOST=smtp.yourprovider.com      # default: smtp.exmail.qq.com（腾讯企业邮）
#CORE_MAIL_PORT=465                        # default: 465（隐式 TLS；见 application.yml）
CORE_MAIL_USERNAME=noreply@yourco.com      # 用于认证的完整邮箱地址
CORE_MAIL_PASSWORD=change-me               # SMTP / 客户端专用密码
CORE_MAIL_FROM=noreply@yourco.com          # default: noreply@localhost
#CORE_MAIL_FROM_NAME=Access Matrix         # default: Access Matrix
CORE_APP_BASE_URL=https://app.yourco.com   # 前端对外基址（邀请/重置链接）；default: http://localhost:5273


# ── [2] KEYCLOAK 引导 — 仅首次启动 ──────────────────────────────────────────
# 上面的 provisioner client 由一次性 KC root admin 在启动时自动创建——无需手动操作控制台。
# ⚠ 日志出现 `[kc-provisioner] provisioner ready` 后立即收紧：
#   设 CORE_KEYCLOAK_BOOTSTRAP_ENABLED=false  并  删除 USERNAME/PASSWORD。
# 把 KC root 凭据留在 env 里，等于平白放着一个高权限密钥。
# 详见 infra/keycloak/README.zh-CN.md（生产环境定型，“自动 bootstrap”）。
#CORE_KEYCLOAK_BOOTSTRAP_ENABLED=true
#CORE_KEYCLOAK_BOOTSTRAP_USERNAME=<一次性 KC root admin — 首次启动后删除>
#CORE_KEYCLOAK_BOOTSTRAP_PASSWORD=<一次性 KC root 密码 — 首次启动后删除>
#CORE_KEYCLOAK_BOOTSTRAP_MANAGED_REALMS=demo,system   # 既有 realm，授予其 manage-users


# ── [3] JWT 回退 — 仅当你改用 legacy HS256 鉴权时 ───────────────────────────
# 生产是 OIDC。若要回退到后端自签 HS256 token（不需要 Keycloak），
# 设 APP_SECURITY_MODE=jwt 并提供强密钥（≥ 32 字节）。
#CORE_JWT_SECRET=     # openssl rand -base64 48
