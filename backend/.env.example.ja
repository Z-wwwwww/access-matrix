# =============================================================================
# access-matrix バックエンド (core-service) — デプロイ用環境変数テンプレート
# English: .env.example  ·  中文: .env.example.zh-CN
# -----------------------------------------------------------------------------
# `backend/.env` にコピーし、環境ごとの値を記入してください。
#
# Spring Boot は .env を自動読み込みしません。本ファイルは環境変数を実際に注入する
# 仕組みのための参照です: docker-compose env_file / systemd EnvironmentFile /
# k8s Secret envFrom / 素の shell `set -a; . ./backend/.env; set +a`。
# （フロントエンドは frontend/.env.* にビルド時 env を別途持ちます。無関係。）
#
# 階層:  [1] 必須    — 設定しないと起動しません。
#        [2] 機能別  — その機能を使う場合のみ必要（メール / 初回起動）。
#        [3] 任意    — それ以外は application*.yml に既定値あり。理由があるときだけ上書きを。
# "# default: X" は変数未設定時に application.yml が使う既定値です。
# =============================================================================


# ── [1] 必須 — 設定しないと起動しない ───────────────────────────────────────

# 有効な Spring プロファイル。未設定 → "prod"（oidc 認証 + テナント分離 ON）。
# 開発時は "local"。（prod プロファイル = application-prod.yml）
#SPRING_PROFILES_ACTIVE=prod

# Postgres — アプリ DB。?stringtype=unspecified は残すこと（jsonb / enum バインディングで依存）。
CORE_DB_URL=jdbc:postgresql://db-host:5432/access_matrix?stringtype=unspecified
CORE_DB_USERNAME=access_matrix
CORE_DB_PASSWORD=change-me

# Redis — セッション / レート制限 / 強制ログアウト。prod プロファイルは TLS で接続します
# （spring.data.redis.ssl.enabled=true）。本番の Redis は TLS 終端できる必要があります。
CORE_REDIS_HOST=redis-host
#CORE_REDIS_PORT=6379          # default: 6379
#CORE_REDIS_PASSWORD=          # default: (なし)
#CORE_REDIS_DB=0               # default: 0

# API を呼び出せるブラウザ origin。カンマ区切り、scheme+host を厳密に（末尾スラッシュなし）。SPA の公開 URL。
CORE_CORS_ALLOWED_ORIGINS=https://app.yourco.com

# SSO / Keycloak — 本番は既定で OIDC のため、以下は必須。
# 実行時、バックエンドは専用サービスアカウント（client_credentials）で Keycloak Admin
# API を呼びます —— 実行時に admin パスワードは不要、その secret だけ。
# ⚠ PROVISIONER_SECRET: バックエンドはこの値を Keycloak へ「push」します。強度はあなたの
#   責任です。dev 既定値（dev-provisioner-secret-change-in-prod）を本番に持ち込まないこと
#   —— create-realm 権限のサービスアカウントに公知のパスワードが付きます。
#   生成: openssl rand -base64 32 → vault に保管。
CORE_OIDC_ISSUER_BASE_URI=https://auth.yourco.com   # マルチ realm 信頼プレフィックス（realm == テナント）
CORE_KEYCLOAK_SERVER_URL=https://auth.yourco.com
CORE_KEYCLOAK_PROVISIONER_SECRET=                   # vault の強い secret；実行時の身元


# ── [2] メール — 招待 / パスワードリセット / オンボーディングを使うなら必須 ──
# 未設定でも起動しますが、これらのフローはメールを送らず、招待ユーザーは設定リンクを
# 受け取れません。本番では有効化を。
CORE_MAIL_ENABLED=true
CORE_MAIL_HOST=smtp.yourprovider.com      # default: smtp.exmail.qq.com（Tencent ExMail）
#CORE_MAIL_PORT=465                        # default: 465（暗黙 TLS。application.yml 参照）
CORE_MAIL_USERNAME=noreply@yourco.com      # 認証に使う完全なメールアドレス
CORE_MAIL_PASSWORD=change-me               # SMTP / クライアント専用パスワード
CORE_MAIL_FROM=noreply@yourco.com          # default: noreply@localhost
#CORE_MAIL_FROM_NAME=Access Matrix         # default: Access Matrix
CORE_APP_BASE_URL=https://app.yourco.com   # フロントエンドの公開 URL（招待/リセットリンク）；default: http://localhost:5273


# ── [2] KEYCLOAK BOOTSTRAP — 初回起動のみ ───────────────────────────────────
# 上の provisioner クライアントは使い捨ての KC root admin から起動時に自動作成されます
# —— コンソール手作業は不要。⚠ ログに `[kc-provisioner] provisioner ready` が出たら即収束:
#   CORE_KEYCLOAK_BOOTSTRAP_ENABLED=false にし、USERNAME/PASSWORD を削除する。
# KC root 資格情報を env に残すのは、強力な秘密を無意味に放置するだけです。
# 詳細は infra/keycloak/README.md（Production posture, "auto-bootstrap"）。
#CORE_KEYCLOAK_BOOTSTRAP_ENABLED=true
#CORE_KEYCLOAK_BOOTSTRAP_USERNAME=<使い捨ての KC root admin — 初回起動後に削除>
#CORE_KEYCLOAK_BOOTSTRAP_PASSWORD=<使い捨ての KC root パスワード — 初回起動後に削除>
#CORE_KEYCLOAK_BOOTSTRAP_MANAGED_REALMS=demo,system   # 既存 realm。manage-users を付与する対象


# ── [3] JWT フォールバック — legacy HS256 認証に切り替える場合のみ ───────────
# 本番は OIDC。バックエンド署名の HS256 トークン（Keycloak 不要）に戻すには、
# APP_SECURITY_MODE=jwt を設定し、強い secret（32 バイト以上）を渡してください。
#CORE_JWT_SECRET=     # openssl rand -base64 48
