# =============================================================================
# access-matrix 后端 (core-service) —— 部署期环境变量模板
# 复制为 `backend/.env` 并填入空值。
#
# 注意：Spring Boot 不会自己读这个文件。它只是给「真正注入环境变量的东西」做参考：
#   docker-compose env_file / systemd EnvironmentFile / k8s Secret envFrom /
#   裸 shell `set -a; . ./backend/.env; set +a`。
#
# 这里只列「生产(oidc)部署必须设」的变量。其余开关都有默认值、且在 application.yml
# 里有逐行中文注释——要改别的，先去那里按变量名搜。
# 本地开发(dev profile)用 application-dev.yml 里已提交的默认值，基本不需要本文件。
# =============================================================================

# 生效的 profile。不设 → prod（带鉴权 + 租户隔离）。本地开发设 dev。
#SPRING_PROFILES_ACTIVE=prod

# 生产其实只涉及 3 个地址：
#   ① 应用前端域名(如 app.yourco.com) → CORS + APP_BASE_URL
#   ② Keycloak 域名(如 auth.yourco.com) → OIDC_ISSUER_BASE_URI + KEYCLOAK_SERVER_URL
#   ③ 内网数据存储 → DB_URL + REDIS_HOST

# ── 数据库 (Postgres) ── 保留 ?stringtype=unspecified（jsonb / enum 绑定要用）
CORE_DB_URL=jdbc:postgresql://db-host:5432/access_matrix?stringtype=unspecified
CORE_DB_USERNAME=access_matrix
CORE_DB_PASSWORD=

# ── Redis ── prod 走 TLS 连 Redis，所以生产的 Redis 必须支持 TLS 终结
CORE_REDIS_HOST=redis-host

# ── CORS ── SPA 的对外来源（应用前端域名，如 app.yourco.com）；多个用逗号分隔，精确到 scheme+host，结尾不带 /
CORE_CORS_ALLOWED_ORIGINS=https://app.yourco.com

# ── SSO / Keycloak（prod 默认 oidc，故以下必填）── 对应 Keycloak 那个域名（如 auth.yourco.com）
# PROVISIONER_SECRET 是后端「推进」Keycloak 设成客户端 secret 的，强度由你负责，
# 绝不能用 dev 默认值。生成：openssl rand -base64 32 → 存进 vault。
#
# ISSUER_BASE_URI：必须等于 Keycloak 实际签发 token 的 iss（即 KC 的对外 hostname），
#   只填到根、不带 /realms/<租户>（多租户一租户一 realm，后端只认这个前缀）；一般填公网地址。
CORE_OIDC_ISSUER_BASE_URI=https://auth.yourco.com
# SERVER_URL：后端调 KC Admin API 用，可填内网地址；简单部署与上面一致即可。
CORE_KEYCLOAK_SERVER_URL=https://auth.yourco.com
CORE_KEYCLOAK_PROVISIONER_SECRET=

# ── 邮件 ── 邀请 / 密码重置 / 开通流程需要；不设也能启动，但这些流程会静默不发信
CORE_MAIL_ENABLED=true
CORE_MAIL_HOST=smtp.yourprovider.com        # 无默认——填你自己的 SMTP 主机（默认按 465 隐式 TLS）
CORE_MAIL_USERNAME=noreply@yourco.com        # 用于认证的完整邮箱地址
CORE_MAIL_PASSWORD=                          # SMTP / 客户端专用密码
CORE_MAIL_FROM=noreply@yourco.com
CORE_APP_BASE_URL=https://app.yourco.com     # 前端对外 URL（同 CORS 的应用域名；邮件里的邀请/重置链接用）

# ── 仅首次部署：引导 Keycloak provisioner 客户端，成功后立即收紧 ──
# 第一次起 prod 时取消注释下面四行。日志出现 `[kc-provisioner] provisioner ready` 后：
#   把 ENABLED 设回 false（或删掉本行），并删掉 USERNAME/PASSWORD——
#   把 KC root 凭据一直留在 env 里 = 平白挂着一个高权限密钥。
# 详见 infra/keycloak/README.md。
#CORE_KEYCLOAK_BOOTSTRAP_ENABLED=true
#CORE_KEYCLOAK_BOOTSTRAP_USERNAME=<一次性 KC root admin —— 引导后删除>
#CORE_KEYCLOAK_BOOTSTRAP_PASSWORD=<一次性 KC root 密码 —— 引导后删除>
#CORE_KEYCLOAK_BOOTSTRAP_MANAGED_REALMS=demo,system
