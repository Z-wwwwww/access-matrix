# =============================================================================
# access-matrix 后端 —— 环境变量模板（dev 默认值 + 上线改动清单）
# 用法：复制为 backend/.env（已 gitignore）并按需填值；IDE 运行配置 / EnvFile 指向 backend/.env，
#       或 `set -a; . ./backend/.env; set +a` 后跑 mvnw。
# 本文件均为 mock / throwaway 值，可提交；真实密钥只写进 backend/.env，永不提交。
# 「未注释」= 默认生效值；每组首行标题注明「本地 | 上线」。
# 行为开关随 SPRING_PROFILES_ACTIVE=prod 自动切换，见文件末尾。
# =============================================================================

# ━━━━━━━━━━ PROFILE | 本地: dev | 上线: prod ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SPRING_PROFILES_ACTIVE=dev
# 鉴权模式 dev/prod 均钉死 oidc(由 profile 设定)；仅需回退 legacy 密码登录时才取消注释
# 下行(并确保 CORE_JWT_SECRET 已设)。# APP_SECURITY_MODE=jwt

# ━━━━━━━━━━ 数据库 | 本地: 本机 Postgres | 上线: 内网库 + 强随机密码 ━━━━━━━━━━━
CORE_DB_URL=jdbc:postgresql://127.0.0.1:5432/access_matrix_db?stringtype=unspecified
CORE_DB_USERNAME=postgres
CORE_DB_PASSWORD=your-db-password

# ━━━━━━━━━━ REDIS | 本地: 本机 1 号库 | 上线: 内网 + 强密码 + TLS(prod 钉死 ssl) ━━
CORE_REDIS_HOST=127.0.0.1
CORE_REDIS_PORT=6379
CORE_REDIS_PASSWORD=your-redis-password
CORE_REDIS_DB=1

# ━━━━━━━━━━ 邮件 | 本地: 默认关,要测时填真实 SMTP | 上线: 生产 SMTP(FROM 须等于 username) ━━
# 本地要测邮件: 设 ENABLED=true 并把下面换成真实凭据(写到 backend/.env,勿提交)。
CORE_MAIL_ENABLED=false
CORE_MAIL_HOST=smtp.example.com
CORE_MAIL_USERNAME=you@example.com
CORE_MAIL_PASSWORD=your-smtp-app-password
CORE_MAIL_FROM=you@example.com

# ━━━━━━━━━━ KC 引导(一次性 root) | 本地: 常开 admin/admin | 上线: 引导后设 false 并删凭据 ━━
CORE_KEYCLOAK_BOOTSTRAP_ENABLED=true
CORE_KEYCLOAK_BOOTSTRAP_USERNAME=admin
CORE_KEYCLOAK_BOOTSTRAP_PASSWORD=admin
# MANAGED_REALMS 本地: demo,system | 上线: 只 system(不含样例 demo；应用自建租户 realm 由 provisioner 自动授权)
CORE_KEYCLOAK_BOOTSTRAP_MANAGED_REALMS=demo,system

# ━━━━━━━━━━ KC provisioner secret | 本地: 弱默认 | 上线: openssl rand -base64 32 + vault ━━
CORE_KEYCLOAK_PROVISIONER_SECRET=dev-provisioner-secret-change-in-prod

# ━━━━━━━━━━ HS256 break-glass 密钥 | 本地/上线: 都必须换成强随机(openssl rand -base64 48) ━━
# 下面这行占位值会被 JwtSecretValidator 在启动期直接拒绝(含 throwaway/dev-local 等标记即 fail-fast)，
# 防止照抄本模板上线导致全站 token 可伪造——复制为 .env 后第一件事就是换掉它。
CORE_JWT_SECRET=dev-local-hs256-break-glass-key-32B+throwaway-do-not-use-in-prod

# ━━━━━━━━━━ 反向代理改写 getRemoteAddr | 本地: none | 上线: 反代后 framework，直连 none ━━
CORE_FORWARD_HEADERS_STRATEGY=none

# ━━━━━━━━━━ 限流/审计是否采信 XFF | 本地: false | 上线: 与上一项成对，反代后 true ━━
CORE_TRUST_FORWARDED_HEADERS=false

# ━━━━━━━━━━ Keycloak 根地址 | 本地: localhost:8180 | 上线: 公网 KC 域名(https,签发 token 的 iss) ━━
CORE_OIDC_ISSUER_BASE_URI=http://localhost:8180
CORE_KEYCLOAK_SERVER_URL=http://localhost:8180

# ━━━━━━━━━━ 前端根地址(邮件链接) | 本地: localhost:5273 | 上线: 应用前端域名(https) ━━
CORE_APP_BASE_URL=http://localhost:5273

# ━━━━━━━━━━ CORS 白名单 | 本地: *(全开) | 上线: 精确白名单(逗号分隔,含 scheme,结尾不带/) ━━
# 例 单域名: https://app.example.com
# 例 多域名: https://app.example.com,https://admin.example.com
# 例 带端口: https://app.example.com:8443
# 反例(勿用): app.example.com(缺 scheme) / https://app.example.com/(结尾带/) / http(上线应 https) / *(放开等于无防护)
CORE_CORS_ALLOWED_ORIGINS=*

# ━━━━━━━━━━ 业务时区 | 本地/上线: 按目标市场(非法 IANA id 启动即失败) ━━━━━━━━━━━
# 必须与前端 VITE_DEFAULT_TIMEZONE 配成同一个值(见 frontend/.env.development
# 与 .env.production,当前均为 Asia/Tokyo)。两边不一致会在「墙钟决策」上产生
# 偏移:cron 触发时刻、日/月聚合 SQL 的 AT TIME ZONE 分桶、取号的日期段、
# 邮件正文里的时间文案——而前端显示仍按自己的时区,对不上账。
CORE_TIMEZONE=Asia/Tokyo

# =============================================================================
# 随 profile=prod 自动切换、无需手动设（仅供知情）：
#   cookie.secure dev=false→prod=true | cookie.same-site Lax→Strict
#   错误细节 dev 暴露→prod 隐藏 | swagger dev 开→prod 关 | redis.ssl dev 关→prod 开
#   freemarker.cache dev 关→prod 开 | flyway.repair dev 开→prod 关(校验和漂移即失败)
#   mybatis.tenant.enabled 恒 true(租户隔离,勿动)
#   actuator: 仅 /actuator/health 公开,metrics/prometheus/caches/info 需鉴权
# =============================================================================
