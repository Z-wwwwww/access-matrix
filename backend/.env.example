# =============================================================================
# access-matrix backend (core-service) — deployment environment template
# 中文: .env.example.zh-CN  ·  日本語: .env.example.ja
# -----------------------------------------------------------------------------
# Copy to `backend/.env` and fill in the values for your environment.
#
# Spring Boot does NOT auto-load .env. This file is a REFERENCE for whatever
# injects the env: docker-compose env_file / systemd EnvironmentFile /
# k8s Secret envFrom / bare shell `set -a; . ./backend/.env; set +a`.
# (The frontend has its own build-time env under frontend/.env.* — unrelated.)
#
# Tiers:  [1] REQUIRED — app won't boot without these.
#         [2] FEATURE  — only if you use that feature (email / first-boot).
#         [3] OPTIONAL — everything else has a default in application*.yml;
#                        override only with a reason (read that file's comments).
# "# default: X" = the value application.yml falls back to when the var is unset.
# =============================================================================


# ── [1] REQUIRED — app won't boot without these ─────────────────────────────

# Active Spring profile. Unset → "prod" (oidc auth + tenant isolation ON).
# Use "local" for development. (prod profile = application-prod.yml)
#SPRING_PROFILES_ACTIVE=prod

# Postgres — the application database. Keep ?stringtype=unspecified (the app
# relies on it for jsonb / enum binding).
CORE_DB_URL=jdbc:postgresql://db-host:5432/access_matrix?stringtype=unspecified
CORE_DB_USERNAME=access_matrix
CORE_DB_PASSWORD=change-me

# Redis — sessions / rate-limit / force-logout. The prod profile connects over
# TLS (spring.data.redis.ssl.enabled=true), so prod Redis must terminate TLS.
CORE_REDIS_HOST=redis-host
#CORE_REDIS_PORT=6379          # default: 6379
#CORE_REDIS_PASSWORD=          # default: (none)
#CORE_REDIS_DB=0               # default: 0

# Browser origins allowed to call the API. Comma-separated, exact scheme+host
# (no trailing slash) — the SPA's public URL(s).
CORE_CORS_ALLOWED_ORIGINS=https://app.yourco.com

# SSO / Keycloak — prod defaults to OIDC, so these are required.
# At runtime the backend talks to Keycloak's Admin API as a dedicated service
# account (client_credentials) — no admin password at runtime, just the secret.
# ⚠ PROVISIONER_SECRET: the backend PUSHES this value INTO Keycloak, so YOU own
#   its strength. Never ship the dev default (dev-provisioner-secret-change-in-prod)
#   to prod — that's a publicly-known credential on a create-realm service account.
#   Generate:  openssl rand -base64 32   → store in vault.
CORE_OIDC_ISSUER_BASE_URI=https://auth.yourco.com   # multi-realm trust prefix (realm == tenant)
CORE_KEYCLOAK_SERVER_URL=https://auth.yourco.com
CORE_KEYCLOAK_PROVISIONER_SECRET=                   # strong vault secret; the runtime identity


# ── [2] EMAIL — required for invites / password reset / onboarding ──────────
# Without these the app still BOOTS, but those flows silently send no mail, so
# invited users never get their set-password link. Enable for any real deployment.
CORE_MAIL_ENABLED=true
CORE_MAIL_HOST=smtp.yourprovider.com      # default: smtp.exmail.qq.com (Tencent ExMail)
#CORE_MAIL_PORT=465                        # default: 465 (implicit TLS; see application.yml)
CORE_MAIL_USERNAME=noreply@yourco.com      # the FULL email address used to authenticate
CORE_MAIL_PASSWORD=change-me               # SMTP / client-specific password
CORE_MAIL_FROM=noreply@yourco.com          # default: noreply@localhost
#CORE_MAIL_FROM_NAME=Access Matrix         # default: Access Matrix
CORE_APP_BASE_URL=https://app.yourco.com   # frontend public URL (invite/reset links); default: http://localhost:5273


# ── [2] KEYCLOAK BOOTSTRAP — FIRST BOOT ONLY ────────────────────────────────
# The provisioner client (above) is auto-created at startup from a one-time KC
# root admin — no manual console setup. ⚠ Once you see
# `[kc-provisioner] provisioner ready` in the logs, lock it down:
#   set CORE_KEYCLOAK_BOOTSTRAP_ENABLED=false  AND  remove USERNAME/PASSWORD.
# Leaving a KC root credential in the env is a needless high-privilege secret.
# See infra/keycloak/README.md (Production posture, "auto-bootstrap").
#CORE_KEYCLOAK_BOOTSTRAP_ENABLED=true
#CORE_KEYCLOAK_BOOTSTRAP_USERNAME=<one-time KC root admin — REMOVE after first boot>
#CORE_KEYCLOAK_BOOTSTRAP_PASSWORD=<one-time KC root password — REMOVE after first boot>
#CORE_KEYCLOAK_BOOTSTRAP_MANAGED_REALMS=demo,system   # pre-existing realms to grant manage-users on


# ── [3] JWT fallback — only if you override to legacy HS256 auth ────────────
# Prod is OIDC. To fall back to backend-signed HS256 tokens (no Keycloak),
# set APP_SECURITY_MODE=jwt and provide a strong secret (>= 32 bytes).
#CORE_JWT_SECRET=     # openssl rand -base64 48
