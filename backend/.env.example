# =============================================================================
# access-matrix backend (core-service) — deploy-time environment variables.
# Copy to `backend/.env` and fill in the blanks.
#
# Spring Boot does NOT read this file — it's a template for whatever injects the
# env (docker-compose env_file / systemd EnvironmentFile / k8s Secret envFrom /
# bare shell `set -a; . ./backend/.env; set +a`).
#
# This lists ONLY the vars you MUST set for a prod (oidc) deployment. Every
# OTHER knob has a default and is documented inline in application.yml —
# search the var name there before overriding anything not listed below.
# =============================================================================

# Active profile. Unset → prod (oidc auth + tenant isolation). Use "local" for dev.
#SPRING_PROFILES_ACTIVE=prod

# ── Database (Postgres) — keep ?stringtype=unspecified (jsonb / enum binding) ──
CORE_DB_URL=jdbc:postgresql://db-host:5432/access_matrix?stringtype=unspecified
CORE_DB_USERNAME=access_matrix
CORE_DB_PASSWORD=

# ── Redis — prod connects over TLS, so prod Redis must terminate TLS ──
CORE_REDIS_HOST=redis-host

# ── CORS — SPA public origin(s); comma-separated, exact scheme+host, no trailing / ──
CORE_CORS_ALLOWED_ORIGINS=https://app.yourco.com

# ── SSO / Keycloak (prod = oidc) ──
# PROVISIONER_SECRET is PUSHED into Keycloak — you own its strength; never use the
# dev default. Generate: openssl rand -base64 32  → store in vault.
CORE_OIDC_ISSUER_BASE_URI=https://auth.yourco.com
CORE_KEYCLOAK_SERVER_URL=https://auth.yourco.com
CORE_KEYCLOAK_PROVISIONER_SECRET=

# ── Email — required for invites / password reset / onboarding ──
# Without these the app boots but those flows silently send no mail.
CORE_MAIL_ENABLED=true
CORE_MAIL_HOST=smtp.yourprovider.com       # no default — set your provider's SMTP host (465 implicit-TLS assumed)
CORE_MAIL_USERNAME=noreply@yourco.com       # full email address used to authenticate
CORE_MAIL_PASSWORD=                         # SMTP / client-specific password
CORE_MAIL_FROM=noreply@yourco.com
CORE_APP_BASE_URL=https://app.yourco.com    # frontend public URL (invite/reset links)

# ── FIRST BOOT ONLY: bootstrap the Keycloak provisioner client, then lock down ──
# Uncomment for the very first prod boot. Once logs show
# `[kc-provisioner] provisioner ready`: set ENABLED=false and remove USER/PASS —
# leaving a KC root credential in the env is a needless high-privilege secret.
# See infra/keycloak/README.md.
#CORE_KEYCLOAK_BOOTSTRAP_ENABLED=true
#CORE_KEYCLOAK_BOOTSTRAP_USERNAME=<one-time KC root admin — REMOVE after first boot>
#CORE_KEYCLOAK_BOOTSTRAP_PASSWORD=<one-time KC root password — REMOVE after first boot>
#CORE_KEYCLOAK_BOOTSTRAP_MANAGED_REALMS=demo,system
