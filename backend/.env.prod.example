# =============================================================================
# access-matrix 后端 —— 生产(prod profile)环境变量「示例」
# 复制为 backend/.env，填入真实值后由部署方注入（docker-compose env_file /
# systemd EnvironmentFile / k8s Secret）。填好的 .env 永不提交（已 gitignore）。
#
# 生产其实只涉及 3 个地址：
#   ① 应用前端域名(app.example.com)   → CORS + APP_BASE_URL
#   ② Keycloak 域名(auth.example.com) → OIDC_ISSUER_BASE_URI + KEYCLOAK_SERVER_URL
#   ③ 内网数据存储                     → DB_URL + REDIS_HOST
# 其余行为开关已在 application.yml / application-prod.yml 定死，无需在此设。
# =============================================================================

SPRING_PROFILES_ACTIVE=prod

# ── 数据库 (Postgres) ── 保留 ?stringtype=unspecified（jsonb / enum 绑定要用）
CORE_DB_URL=jdbc:postgresql://pg-prod.internal:5432/access_matrix?stringtype=unspecified
CORE_DB_USERNAME=access_matrix_app
CORE_DB_PASSWORD=<强随机密码，用 secret manager 注入>

# ── Redis ── prod 钉了 ssl.enabled=true，Redis 必须支持 TLS 终结
CORE_REDIS_HOST=redis-prod.internal
CORE_REDIS_PORT=6379
CORE_REDIS_PASSWORD=<Redis AUTH 密码，生产建议设>
CORE_REDIS_DB=0

# ── CORS ── 应用前端域名；多个逗号分隔，精确 scheme+host，结尾不带 /
CORE_CORS_ALLOWED_ORIGINS=https://app.example.com

# ── SSO / Keycloak (prod 默认 oidc) ──
# ISSUER_BASE_URI 必须 = KC 实际签发 token 的 iss（公网 hostname），只到根、不带 /realms/<租户>。
# PROVISIONER_SECRET 是后端「推进」KC 的，强度由你负责：openssl rand -base64 32 → 存 vault。
CORE_OIDC_ISSUER_BASE_URI=https://auth.example.com
CORE_KEYCLOAK_SERVER_URL=https://auth.example.com
CORE_KEYCLOAK_PROVISIONER_SECRET=<openssl rand -base64 32>

# ── 邮件 ── 邀请 / 密码重置 / 开通需要；不设则这些流程静默不发信
CORE_MAIL_ENABLED=true
CORE_MAIL_HOST=smtp.your-provider.com
CORE_MAIL_USERNAME=noreply@example.com
CORE_MAIL_PASSWORD=<SMTP / 客户端专用密码>
CORE_MAIL_FROM=noreply@example.com
CORE_APP_BASE_URL=https://app.example.com

# ── 仅首次部署：引导 Keycloak provisioner 客户端，成功后立即收紧 ──
# 第一次起 prod 时取消注释下面几行；日志出现 `[kc-provisioner] provisioner ready` 后：
#   删掉 USERNAME/PASSWORD，并把 ENABLED 设回 false（不留高权 KC root 凭据）。
#CORE_KEYCLOAK_BOOTSTRAP_ENABLED=true
#CORE_KEYCLOAK_BOOTSTRAP_USERNAME=<一次性 KC root admin —— 引导后删除>
#CORE_KEYCLOAK_BOOTSTRAP_PASSWORD=<一次性 KC root 密码 —— 引导后删除>
# 只列「预先导入、非应用创建」的 realm；prod 通常只 system（不含样例 demo），
# 应用自己建的租户 realm 由 provisioner 自动授权、无需列。
#CORE_KEYCLOAK_BOOTSTRAP_MANAGED_REALMS=system

# ── 可选：回退到 legacy jwt 鉴权时才需要（prod 默认 oidc，一般不用）──
#APP_SECURITY_MODE=jwt
#CORE_JWT_SECRET=<openssl rand -base64 48；>=32 字节>
