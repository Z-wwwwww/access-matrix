# =============================================================================
# access-matrix 后端 —— 本地开发(dev profile)的环境变量
# 把它挂到 IDE 的运行配置加载：IntelliJ → Run/Debug Configurations →
#   Environment variables（或 EnvFile 插件指向本文件）。
# 也可 `set -a; . ./backend/.env.dev; set +a` 后再跑 mvnw。
# 都是本地 throwaway 值，可提交；真实密钥永远走 backend/.env（已 gitignore）。
# =============================================================================

SPRING_PROFILES_ACTIVE=dev

# ── 数据库（本地 Postgres）── 保留 ?stringtype=unspecified（jsonb / enum 绑定要用）
CORE_DB_URL=jdbc:postgresql://127.0.0.1:5432/access_matrix_db?stringtype=unspecified
CORE_DB_USERNAME=postgres
CORE_DB_PASSWORD=abcd@1234

# ── Redis（本地）── 用 1 号库，避开默认 0
CORE_REDIS_HOST=127.0.0.1
CORE_REDIS_PORT=6379
CORE_REDIS_PASSWORD=abcd@1234
CORE_REDIS_DB=1

# ── 邮件 ── 默认 dev 会真发，但 host/账号要你自己填；不想发就设 CORE_MAIL_ENABLED=false
#CORE_MAIL_ENABLED=true
#CORE_MAIL_HOST=smtp.exmail.qq.com
#CORE_MAIL_USERNAME=you@your-company.com
#CORE_MAIL_PASSWORD=
#CORE_MAIL_FROM=you@your-company.com
