<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.platform</groupId>
        <artifactId>AM-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>business-demo</artifactId>
    <name>business-demo</name>
    <description>Demo business module — showcases data-scope (ALL/DEPT_AND_SUB/DEPT/SELF/CUSTOM) end-to-end via a simple Task entity</description>

    <dependencies>
        <dependency>
            <groupId>com.platform</groupId>
            <artifactId>core-infrastructure</artifactId>
        </dependency>
        <!-- DemoSeeder (dev profile) needs the UserEntity / mappers from core-system -->
        <dependency>
            <groupId>com.platform</groupId>
            <artifactId>core-system</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test — exclusions mirror core-system/pom.xml verbatim: the project uses
             log4j-slf4j2-impl (via spring-boot-starter-log4j2) and starter-test
             transitively pulls spring-boot-starter-logging, which brings logback +
             log4j-to-slf4j and trips log4j's "cannot be present with log4j-to-slf4j"
             classpath check at test time. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
